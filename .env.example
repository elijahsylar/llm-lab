# Copy to .env and adjust. start.sh loads it; all values are optional.

# Extra browser origins allowed to call the API (comma-separated),
# e.g. a deployed habit-tracker frontend.
LLM_LAB_ALLOWED_ORIGINS=https://pht.example.com

# Directory of GGUF models shared with other local apps. Full fine-tune
# exports are written here. Default: ./models/shared
LLM_LAB_SHARED_MODELS_DIR=./models/shared

# Ollama endpoint. Default: http://localhost:11434
OLLAMA_BASE=http://localhost:11434

# llama.cpp source checkout (for convert_hf_to_gguf.py and llama-quantize).
LLAMA_CPP_DIR=~/llama.cpp
